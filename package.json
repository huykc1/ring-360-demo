{
  "name": "ring-360-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:editor": "vite build --mode editor",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:site": "bash scripts/build-site.sh",
    "preview:site": "vite preview --outDir _site --port 8091",
    "release": "bash scripts/release.sh",
    "release:latest": "bash scripts/release.sh latest"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  }
}
